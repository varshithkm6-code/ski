// SkillBridge Production Prisma Schema (MongoDB Atlas)
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  role           String    @default("CANDIDATE")
  cohortId       String?
  analyticsOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile        Profile?
  analyses       Analysis[]
  progressEvents ProgressEvent[]

  @@map("users")
}

model Profile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  rawTextEnc    String?
  parsedData    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileSkills ProfileSkill[]

  @@map("profiles")
}

model ProfileSkill {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String       @db.ObjectId
  skillId       String       @db.ObjectId
  proficiency   Int
  evidenceType  String       @default("SELF_RATED")
  evidenceNotes String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([profileId, skillId])
  @@map("profile_skills")
}

model Skill {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  canonicalName String        @unique
  category      String        @default("TECHNICAL")
  aliases       String        @default("[]")
  description   String?

  profileSkills ProfileSkill[]
  roleSkills    RoleSkill[]
  gaps          Gap[]
  roadmapItems  RoadmapItem[]

  @@map("skills")
}

model Role {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  title       String
  seniority   String    @default("ENTRY")
  description String?
  isCustom    Boolean   @default(false)
  createdById String?

  roleSkills RoleSkill[]
  analyses   Analysis[]

  @@map("roles")
}

model RoleSkill {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  roleId         String  @db.ObjectId
  skillId        String  @db.ObjectId
  required       Boolean @default(true)
  weight         Float   @default(1.0)
  minProficiency Int     @default(3)

  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([roleId, skillId])
  @@map("role_skills")
}

model Analysis {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  roleId     String   @db.ObjectId
  score      Float
  breakdown  Json
  aiInsights Json?
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  gaps         Gap[]
  roadmapItems RoadmapItem[]

  @@index([userId, createdAt])
  @@map("analyses")
}

model Gap {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  analysisId          String    @db.ObjectId
  skillId             String    @db.ObjectId
  status              String    @default("MISSING")
  userProficiency     Int       @default(0)
  requiredProficiency Int       @default(3)
  evidenceStrength    Float     @default(0)
  weight              Float     @default(1.0)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@map("gaps")
}

model RoadmapItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  analysisId     String       @db.ObjectId
  skillId        String       @db.ObjectId
  phase          String       @default("DAYS_30")
  title          String
  whyItMatters   String
  resourceTypes  String       @default("[]")
  estimatedHours Int
  milestone      String
  projectIdea    String?
  completed      Boolean      @default(false)
  completedAt    DateTime?
  sortOrder      Int          @default(0)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@index([analysisId])
  @@map("roadmap_items")
}

model ProgressEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  analysisId String?  @db.ObjectId
  eventType  String
  payload    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_events")
}
